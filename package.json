{
  "name": "waido",
  "version": "0.4.0",
  "description": "Wide events for Node.js: one rich event per request, tail sampling, and OpenTelemetry export",
  "keywords": [
    "asynclocalstorage",
    "canonical-log-line",
    "context",
    "express",
    "observability",
    "opentelemetry",
    "tail-sampling",
    "wide-events"
  ],
  "homepage": "https://github.com/davidweterings/waido#readme",
  "bugs": {
    "url": "https://github.com/davidweterings/waido/issues"
  },
  "license": "MIT",
  "author": "David Weterings",
  "repository": {
    "type": "git",
    "url": "https://github.com/davidweterings/waido"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#src/*": {
      "types": "./src/*",
      "default": "./dist/*"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./express": {
      "types": "./dist/adapters/express.d.ts",
      "import": "./dist/adapters/express.js"
    },
    "./otel": {
      "types": "./dist/otel.d.ts",
      "import": "./dist/otel.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsgo --noEmit && tsgo --noEmit -p examples/tsconfig.json",
    "lint": "oxlint",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm fmt:check && pnpm test",
    "prepublishOnly": "npm run clean && npm run build && npm test",
    "publish:ci": "pnpm build && pnpm changeset publish",
    "publish:version": "pnpm changeset version && pnpm fmt"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.300.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/instrumentation": "^0.300.0",
    "@opentelemetry/instrumentation-express": "^0.72.0",
    "@opentelemetry/instrumentation-http": "^0.300.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-logs": "^3.0.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.17",
    "@typescript/native-preview": "7.0.0-dev.20260319.1",
    "express": "^5.1.0",
    "express4": "npm:express@^4",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.56.0",
    "typescript": "^5.8.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.1.8"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.10.0",
    "express": "^4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    },
    "express": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@9.14.4+sha512.c8180b3fbe4e4bca02c94234717896b5529740a6cbadf19fa78254270403ea2f27d4e1d46a08a0f56c89b63dc8ebfd3ee53326da720273794e6200fcf0d184ab"
}
